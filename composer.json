{
    "name": "sgflores/cruder",
    "description": "A comprehensive CRUD service package",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "sgflores",
            "email": "floresopic@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/validation": "^10.0|^11.0|^12.0",
        "illuminate/pagination": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "SgFlores\\Cruder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SgFlores\\Cruder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SgFlores\\Cruder\\CruderServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "test-coverage": "phpunit --configuration=phpunit-with-coverage.xml",
        "test-unit": "phpunit --testsuite=Unit --no-coverage",
        "test-integration": "phpunit --testsuite=Integration --no-coverage",
        "test-feature": "phpunit --testsuite=Feature --no-coverage",
        "test-all": "phpunit --testsuite=Unit --testsuite=Integration --testsuite=Feature --no-coverage"
    }
}